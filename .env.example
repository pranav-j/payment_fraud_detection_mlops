# ----------------------------------------------------------------------------
# fraud-mlops environment configuration
#
# Copy to .env and fill in. .env is gitignored — never commit real values.
# AWS credentials are NOT stored here: they come from `aws configure` (~/.aws).
# Only the region is set as an env var.
# ----------------------------------------------------------------------------

# --- Data source (Kaggle, for downloading PaySim) ---------------------------
# Used by scripts/download_data.sh. (If you instead use ~/.kaggle/kaggle.json,
# these can be left blank.)
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- AWS --------------------------------------------------------------------
# Credentials are discovered from ~/.aws (aws configure) or an IAM role.
# Do not put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here.
AWS_DEFAULT_REGION=ap-south-1

# --- RDS Postgres (MLflow backend store + decisions audit table) ------------
RDS_HOST=your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=mlflow
RDS_USER=fraud_admin
RDS_PASSWORD=
# TLS mode. Leave as `require` for RDS. A local Postgres container has no TLS,
# so point a local run at `prefer`.
RDS_SSLMODE=require

# --- MLflow -----------------------------------------------------------------
# Local server URL for development; the Fargate/Lambda paths set their own.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# Artifact store (the model .pkl files live here, in S3).
MLFLOW_ARTIFACT_ROOT=s3://your-bucket/mlflow-artifacts
# Leave EMPTY for real AWS S3. Only set this for S3-compatible endpoints (e.g. MinIO).
MLFLOW_S3_ENDPOINT_URL=

# --- Redis (Feast online store, running on EC2) -----------------------------
# Consumed by feature_repo/feature_store.yaml via ${REDIS_CONNECTION_STRING}.
# Use the Redis PRIVATE IP for the Lambda path; the PUBLIC IP for local runs.
REDIS_CONNECTION_STRING=10.0.0.0:6379
# Public IP, used for local materialization / SSH (changes when the EC2 restarts).
REDIS_PUBLIC_IP=0.0.0.0

# --- Model rollout ----------------------------------------------------------
# How long a warm Lambda container may serve a cached @production model before
# re-resolving the alias. Without this a warm container serves a superseded
# model until AWS happens to recycle it. 0 disables the re-check. (ADR-022)
MODEL_TTL_SECONDS=900

# --- Labels and performance monitoring --------------------------------------
# Wall-clock hours between a decision and its outcome label becoming knowable,
# used by scripts/replay_labels.py. Production would be ~720 (a 30-day
# chargeback window); a demo uses a small value so the effect is visible in
# minutes. PaySim's `step` is a *simulated* hour and is unrelated to this.
LABEL_DELAY_HOURS=0.05
# Realized-recall floor below which the daily performance flow raises an alert.
PERFORMANCE_RECALL_FLOOR=0.70
# SNS topic for drift and performance alerts. Leave blank to build it from
# AWS_ACCOUNT_ID; set it explicitly to avoid hardcoding an account anywhere.
SNS_TOPIC_ARN=
AWS_ACCOUNT_ID=

# --- Monitoring ---------------------------------------------------------------
# Prometheus Pushgateway, written to by the drift and performance flows.
PUSHGATEWAY_URL=localhost:9091

# --- Feast ------------------------------------------------------------------
# Disable anonymous usage telemetry (optional).
FEAST_USAGE=False
