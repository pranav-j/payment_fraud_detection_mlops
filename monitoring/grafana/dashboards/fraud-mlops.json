{
  "uid": "fraud-mlops",
  "title": "Fraud detector \u2014 drift and realized performance",
  "description": "Top: did the model get it right, against labels that have matured. Bottom: has the input data moved. The two answer different questions, and a shift can show in one without the other.",
  "tags": [
    "fraud-mlops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 4,
      "type": "timeseries",
      "title": "Realized performance (matured labels only)",
      "description": "Precision and recall against outcome labels that have actually arrived. A flat or missing right-hand edge is expected \u2014 those decisions have no labels yet. See the maturity panel beside this one.",
      "datasource": {
        "type": "prometheus",
        "uid": "fraud-mlops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraud_detector_realized_recall",
          "legendFormat": "realized recall",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-mlops-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "fraud_detector_realized_precision",
          "legendFormat": "realized precision",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-mlops-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "0.70",
          "legendFormat": "recall floor (alert)",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "fraud-mlops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "axisPlacement": "auto",
            "gradientMode": "none"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
